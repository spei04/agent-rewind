# Run `rewind init` to generate private local encryption and bootstrap keys.
REWIND_ENCRYPTION_KEY=
REWIND_BOOTSTRAP_KEY=
REWIND_MODE=development
REWIND_DATABASE_URL=sqlite:///.rewind/metadata.sqlite
REWIND_DATA_DIR=.rewind
REWIND_PUBLIC_URL=http://127.0.0.1:8080

# Worker-only settings. Never put a provider key in browser code or task manifests.
REWIND_MODEL_URL=https://api.openai.com/v1/chat/completions
REWIND_MODEL_API_KEY=
REWIND_MODEL_NAME=
# USD per million tokens; use upper rates including cache writes for the allowed context.
REWIND_MODEL_INPUT_PRICE=0
REWIND_MODEL_OUTPUT_PRICE=0
REWIND_MODEL_REASONING_EFFORT=
REWIND_MODEL_MAX_INPUT_TOKENS=128000
REWIND_MODEL_MAX_OUTPUT_TOKENS=2048
REWIND_MODEL_SEED_SUPPORTED=false

# Production requires runsc and digest-pinned, preinstalled allowlisted images.
REWIND_SANDBOX_RUNTIME=runsc
REWIND_ALLOW_INSECURE_RUNTIME=false
REWIND_ALLOWED_IMAGES=
REWIND_WORKSPACE_MB=32
REWIND_SANDBOX_MEMORY_MB=512

# Production identity login (authorization code + PKCE).
REWIND_OIDC_ISSUER=
REWIND_OIDC_CLIENT_ID=
REWIND_OIDC_CLIENT_SECRET=
REWIND_OIDC_AUDIENCE=
REWIND_OIDC_ROLE_CLAIM=rewind_role

# Local encrypted objects for development, or an organization-owned S3 bucket.
REWIND_STORAGE=local
REWIND_S3_BUCKET=
REWIND_S3_REGION=us-east-1
