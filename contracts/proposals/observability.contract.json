  "readiness_cases": [
    {
      "id": "ready",
      "checks": {
        "database": "ready",
        "schema": "ready",
        "artifacts": "ready",
        "encryption": "ready"
      },
      "draining": false,
      "expected_liveness": 200,
      "expected_readiness": 200,
      "expected_code": null
    },
    {
      "id": "database_down",
      "checks": {
        "database": "not_ready",
        "schema": "ready",
        "artifacts": "ready",
        "encryption": "ready"
      },
      "draining": false,
      "expected_liveness": 200,
      "expected_readiness": 503,
      "expected_code": "dependency_unavailable"
    },
    {
      "id": "unsupported_schema",
      "checks": {
        "database": "ready",
        "schema": "not_ready",
        "artifacts": "ready",
        "encryption": "ready"
      },
      "draining": false,
      "expected_liveness": 200,
      "expected_readiness": 503,
      "expected_code": "schema_incompatible"
    },
    {
      "id": "artifact_timeout",
      "checks": {
        "database": "ready",
        "schema": "ready",
        "artifacts": "not_ready",
        "encryption": "ready"
      },
      "draining": false,
      "expected_liveness": 200,
      "expected_readiness": 503,
      "expected_code": "dependency_unavailable"
    },
    {
      "id": "key_unavailable",
      "checks": {
        "database": "ready",
        "schema": "ready",
        "artifacts": "ready",
        "encryption": "not_ready"
      },
      "draining": false,
      "expected_liveness": 200,
      "expected_readiness": 503,
      "expected_code": "dependency_unavailable"
    },
    {
      "id": "unknown_probe",
      "checks": {
        "database": "unknown",
        "schema": "unknown",
        "artifacts": "unknown",
        "encryption": "unknown"
      },
      "draining": false,
      "expected_liveness": 200,
      "expected_readiness": 503,
      "expected_code": "dependency_unavailable"
    },
    {
      "id": "draining",
      "checks": {
        "database": "ready",
        "schema": "ready",
        "artifacts": "ready",
        "encryption": "ready"
      },
      "draining": true,
      "expected_liveness": 200,
      "expected_readiness": 503,
      "expected_code": "dependency_unavailable"
    }
  ],
  "readiness_policy": {
    "positive_cache_seconds": 5,
    "maximum_probe_seconds": 1,
    "sentinel_maximum_bytes": 4096,
    "required_checks": [
      "database",
      "schema",
      "artifacts",
      "encryption"
    ]
  },
