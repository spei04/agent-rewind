{
  "contract": "C04",
  "schema_version": 1,
  "status": "proposed-for-AR-004-B",
  "runtime_implemented": false,
  "error_rules": {
    "invalid_request": {
      "statuses": [
        422,
        413
      ],
      "messages": [
        "Request does not match the supported input contract.",
        "Request body exceeds 9 MiB.",
        "Task manifest exceeds 8 MiB."
      ],
      "retryable": false
    },
    "unauthenticated": {
      "statuses": [
        401
      ],
      "messages": [
        "Authentication is required."
      ],
      "retryable": false
    },
    "forbidden": {
      "statuses": [
        403
      ],
      "messages": [
        "This action is not permitted."
      ],
      "retryable": false
    },
    "not_found": {
      "statuses": [
        404
      ],
      "messages": [
        "Resource not found."
      ],
      "retryable": false
    },
    "invalid_cursor": {
      "statuses": [
        422
      ],
      "messages": [
        "Cursor is invalid for this request."
      ],
      "retryable": false
    },
    "idempotency_conflict": {
      "statuses": [
        409
      ],
      "messages": [
        "Request identity was already used with different input."
      ],
      "retryable": false
    },
    "budget_exhausted": {
      "statuses": [
        409
      ],
      "messages": [
        "The permitted budget is exhausted."
      ],
      "retryable": false
    },
    "quota_exceeded": {
      "statuses": [
        429
      ],
      "messages": [
        "Admission quota is temporarily exceeded."
      ],
      "retryable": true
    },
    "dependency_unavailable": {
      "statuses": [
        503
      ],
      "messages": [
        "A required service is temporarily unavailable."
      ],
      "retryable": true
    },
    "schema_incompatible": {
      "statuses": [
        503
      ],
      "messages": [
        "Service schema is not compatible with this release."
      ],
      "retryable": false
    },
    "internal_error": {
      "statuses": [
        500
      ],
      "messages": [
        "The request could not be completed."
      ],
      "retryable": false
    },
    "outcome_uncertain": {
      "statuses": [
        503
      ],
      "messages": [
        "The operation outcome is not yet known; reconcile the original request.",
        "The provider outcome is not yet known; do not dispatch a new call."
      ],
      "retryable": false
    }
  },
