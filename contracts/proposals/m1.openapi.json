  "components": {
    "securitySchemes": {
      "serviceKey": {
        "type": "http",
        "scheme": "bearer"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "rewind_session"
      }
    },
    "schemas": {
      "TaskDefinition": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "instruction": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Instruction",
            "type": "string"
          },
          "image": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Image",
            "type": "string"
          },
          "files": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Files",
            "type": "object"
          },
          "evaluator_files": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Evaluator Files",
            "type": "object"
          },
          "evaluator_command": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Evaluator Command",
            "type": "string"
          },
          "max_steps": {
            "default": 30,
            "maximum": 100,
            "minimum": 1,
            "title": "Max Steps",
            "type": "integer"
          },
          "command_timeout": {
            "default": 30,
            "maximum": 120,
            "minimum": 1,
            "title": "Command Timeout",
            "type": "integer"
          },
          "redact_patterns": {
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "maxItems": 16,
            "title": "Redact Patterns",
            "type": "array"
          }
        },
        "required": [
          "name",
          "instruction",
          "image",
          "files",
          "evaluator_files",
          "evaluator_command"
        ],
        "title": "TaskDefinition",
        "type": "object",
        "description": "Existing TaskSpec fields without budget_usd/seed. Preserve current semantic validation: normalized paths, disjoint source/evaluator paths, at most 2,000 initial files, 8 MiB manifest limit, and redaction pattern length 120. These cross-field rules are not all expressible by this schema."
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthenticated",
              "forbidden",
              "not_found",
              "idempotency_conflict",
              "invalid_cursor",
              "budget_exhausted",
              "quota_exceeded",
              "dependency_unavailable",
              "schema_incompatible",
              "internal_error"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 300
          },
          "request_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "retryable"
        ]
      },
      "SubmitRun": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_operation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "adapter_config_id": {
            "type": "string",
            "enum": [
              "native-v1"
            ],
            "description": "M1 supports the administrator-configured native adapter only. Resolve and freeze full policy identity on admission."
          },
          "task": {
            "$ref": "#/components/schemas/TaskDefinition"
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "budget_microusd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200000000
          }
        },
        "required": [
          "client_operation_id",
          "adapter_config_id",
          "task",
          "seed",
          "budget_microusd"
        ]
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "job_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        },
        "required": [
          "operation_id",
          "job_id"
        ]
      },
      "RunSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "project_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "complete",
              "failed",
              "incomplete"
            ]
          },
          "branchable": {
            "type": "boolean"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "event_head": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "project_id",
          "created_at",
          "status",
          "branchable",
          "parent_id",
          "event_head"
        ]
      },
      "RunPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/RunSummary"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "Operation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "project_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "job_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "client_operation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "cancel_requested": {
            "type": "boolean"
          },
          "result_run_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "budget_microusd": {
            "type": "integer",
            "minimum": 1
          },
          "reserved_microusd": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "project_id",
          "job_id",
          "client_operation_id",
          "status",
          "cancel_requested",
          "result_run_id",
          "budget_microusd",
          "reserved_microusd",
          "error"
        ]
      },
      "Cancellation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "cancel_requested": {
            "const": true
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          }
        },
        "required": [
          "operation_id",
          "cancel_requested",
          "status"
        ]
      }
    }
  }
}
